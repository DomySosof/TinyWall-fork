        <Property Id="ARPCOMMENTS" Value="A non-intrusive firewall solution." />
        <Property Id="ARPCONTACT" Value="Károly Pados" />
        <Property Id="ARPURLINFOABOUT" Value="http://tinywall.pados.hu" />
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="The default configuration of TinyWall is to block most programs. If an application is unable to access the network, remember to use one of the &quot;Whitelist by...&quot; options from the tray menu." />
        <Property Id="NEWER_FOUND" Secure="yes" />
        <Property Id="OLDER_INCOMPATIBLE_FOUND" Secure="yes" />
        <Property Id="OLDER_UPGRADEABLE_FOUND" Secure="yes" />
        <Property Id="SELF_FOUND" Secure="yes" />
        <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
            <RegistrySearch Id="BuildNumberSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" />
        </Property>
        <Property Id="WIX_IS_NETFRAMEWORK_48_OR_LATER_INSTALLED" Secure="yes" />
        <Property Id="WIXNETFX4RELEASEINSTALLED" Secure="yes" />
        <UI>
            <TextStyle Id="WarningFontStyle" FaceName="Tahoma" Size="8" Red="160" Green="0" Blue="110" />
            <Dialog Id="CustomWelcomeDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] 3.6.1 Setup">
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" TabSkip="no" Default="yes">
                    <Publish Property="WixUI_InstallMode" Value="Update">Installed AND PATCH</Publish>
                    <Publish Event="NewDialog" Value="RemoteWarnDlg">NOT Installed</Publish>
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Text="WixUI_Bmp_Dialog" TabSkip="no" Disabled="yes" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no" Disabled="yes" />
                <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="60" Text="The Setup Wizard will install [ProductName] on your computer. Click Next to continue or Cancel to exit the Setup Wizard." TabSkip="yes" Transparent="yes" NoPrefix="yes">
                    <Condition Action="show">NOT Installed OR NOT PATCH</Condition>
                    <Condition Action="hide">Installed AND PATCH</Condition>
                </Control>
                <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Text="{\WixUI_Font_Bigger}Welcome to the [ProductName] Setup Wizard" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="PatchDescription" Type="Text" X="135" Y="80" Width="220" Height="60" Text="The Setup Wizard will update [ProductName] on your computer. Click Next to continue or Cancel to exit the Setup Wizard." TabSkip="yes" Transparent="yes" NoPrefix="yes">
                    <Condition Action="show">Installed AND PATCH</Condition>
                    <Condition Action="hide">NOT Installed OR NOT PATCH</Condition>
                </Control>
            </Dialog>
            <Dialog Id="RemoteWarnDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] Setup">
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="CustomWelcomeDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Text="WixUI_Bmp_Dialog" TabSkip="no" Disabled="yes" />
                <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60" Text="{\WixUI_Font_Bigger}Remote Installations" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="Description1" Type="Text" X="135" Y="80" Width="220" Height="60" Text="{\WarningFontStyle}TinyWall only allows network traffic that you have explicitly whitelisted AFTER installation." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Description2" Type="Text" X="135" Y="120" Width="220" Height="60" Text="{\WarningFontStyle}To prevent locking yourself out of this machine, always install TinyWall locally, not over a remote connection." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Description3" Type="Text" X="135" Y="160" Width="220" Height="60" Text="{\WarningFontStyle}If you are not using a remote connection currently, please ignore this warning." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
            </Dialog>
        </UI>
        <UIRef Id="WixUI_Minimal" />
        <Upgrade Id="{0D009F71-BB22-4962-AEE0-6D42FA952B84}">
            <UpgradeVersion Maximum="3.0.0.0" Property="OLDER_INCOMPATIBLE_FOUND" OnlyDetect="yes" IncludeMinimum="yes" />
            <UpgradeVersion Minimum="3.6.1.0" Property="NEWER_FOUND" OnlyDetect="yes" />
            <UpgradeVersion Minimum="3.6.1.0" Maximum="3.6.1.0" Property="SELF_FOUND" OnlyDetect="yes" IncludeMinimum="yes" IncludeMaximum="yes" />
            <UpgradeVersion Minimum="3.0.0.0" Maximum="3.6.1.0" Property="OLDER_UPGRADEABLE_FOUND" IncludeMinimum="yes" />
        </Upgrade>
        <InstallExecuteSequence>
            <Custom Action="FoundIncompatibleVersion" After="FindRelatedProducts">OLDER_INCOMPATIBLE_FOUND</Custom>
            <Custom Action="FoundNewerVersion" After="FoundIncompatibleVersion">NEWER_FOUND</Custom>
            <Custom Action="SetARPINSTALLLOCATION" After="RemoveExistingProducts" />
            <Custom Action="UninstallCustom" Before="UnpublishFeatures">REMOVE="ALL"</Custom>
            <Custom Action="InstallCustomRollback" Before="InstallCustom">NOT Installed</Custom>
            <Custom Action="InstallCustom" Before="StartController">NOT Installed</Custom>
            <Custom Action="StartController" Before="StartControllerAndDetect">(NOT Installed) AND OLDER_UPGRADEABLE_FOUND</Custom>
            <Custom Action="StartControllerAndDetect" Before="InstallFinalize">(NOT Installed) AND (NOT OLDER_UPGRADEABLE_FOUND)</Custom>
            <RemoveExistingProducts After="InstallValidate">OLDER_UPGRADEABLE_FOUND</RemoveExistingProducts>
        </InstallExecuteSequence>
        <InstallUISequence>
            <Custom Action="FoundNewerVersion" Sequence="26">NEWER_FOUND</Custom>
            <Custom Action="FoundIncompatibleVersion" Sequence="27">OLDER_INCOMPATIBLE_FOUND</Custom>
            <Show Dialog="CustomWelcomeDlg" Sequence="1296">NOT Installed OR PATCH</Show>
            <LaunchConditions Sequence="100" />
            <FindRelatedProducts Sequence="25" />
            <ValidateProductID Sequence="700" />
            <CostInitialize Sequence="800" />
            <FileCost Sequence="900" />
            <CostFinalize Sequence="1000" />
            <ExecuteAction Sequence="1300" />
        </InstallUISequence>
    </Product>
</Wix>